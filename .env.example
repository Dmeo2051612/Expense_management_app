# Copy this file to .env and replace every placeholder before starting.
# Use strong random passwords. Keep .env out of Git.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MYSQL_USER=qly_app
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD

# Must match the JWT validation configuration in Program.cs.
JWT_ISSUER=expense-management-api
JWT_AUDIENCE=expense-management-client
JWT_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG

# Actual browser frontend origin; this is only an example.
ALLOWED_ORIGINS=http://localhost:8080
